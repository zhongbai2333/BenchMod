{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zhongbai233.com/mod-bench/report/1.0.0",
  "title": "ModBench Report",
  "description": "Authoritative report emitted by a ModBench runtime.",
  "type": "object",
  "required": ["schema", "run", "environment", "artifacts", "providers", "scenarios", "summary", "diagnostics"],
  "properties": {
    "schema": { "const": "1.0.0" },
    "run": {
      "type": "object",
      "required": ["id", "suite", "runType", "side", "seed", "startedAt", "finishedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "suite": { "type": "string", "minLength": 1 },
        "runType": { "enum": ["server", "client", "gameTestServer"] },
        "side": { "enum": ["DEDICATED_SERVER", "INTEGRATED_CLIENT", "GAME_TEST_SERVER"] },
        "seed": { "type": "integer" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "required": ["os", "java", "versions", "loadedMods"],
      "properties": {
        "os": { "type": "object" },
        "java": { "type": "object" },
        "versions": { "type": "object" },
        "loadedMods": { "type": "array", "items": { "$ref": "#/$defs/nameVersion" } }
      },
      "additionalProperties": true
    },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "className", "targetMod", "apiCompatibility"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "className": { "type": "string", "minLength": 1 },
          "targetMod": { "type": "string", "minLength": 1 },
          "apiCompatibility": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "providerId", "status", "workloadCorrect", "phases", "metrics"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "providerId": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/status" },
          "workloadCorrect": { "type": "boolean" },
          "failure": { "type": ["object", "null"] },
          "phases": { "type": "array", "items": { "type": "object" } },
          "metrics": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": ["status", "counts"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "counts": { "type": "object" }
      },
      "additionalProperties": true
    },
    "diagnostics": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "status": {
      "enum": ["PASSED", "FAILED", "SKIPPED", "INCOMPATIBLE", "TIMED_OUT", "ABORTED", "INCONCLUSIVE"]
    },
    "nameVersion": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}